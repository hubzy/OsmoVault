<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>OsmoVault</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- 故意用单词而非 com.xxx：可执行文件时代的 UserDefaults suite 就叫
	     OsmoVault，这里保持一致，导入记录/来源文件夹不会丢 -->
	<key>CFBundleIdentifier</key>
	<string>OsmoVault</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OsmoVault</string>
	<key>CFBundleDisplayName</key>
	<string>OsmoVault</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<!-- 一键出片页的 App 内拖放类型：UTType(exportedAs:) 运行时注册之外，
	     再在 bundle 层正式声明一次，保证 onDrop 的系统校验在所有场景都能匹配 -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.osmovault.asset</string>
			<key>UTTypeDescription</key>
			<string>OsmoVault 素材拖放载荷</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.osmovault.clip</string>
			<key>UTTypeDescription</key>
			<string>OsmoVault 时间轴片段拖放载荷</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
